{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "OS Club CU Brand OS",
    "version": "1.0.0",
    "spacingBasePx": 8
  },
  "color": {
    "club": {
      "orange": { "$type": "color", "$value": "#FC8A05" }
    },
    "dark": {
      "900": { "$type": "color", "$value": "#0D0D0F" },
      "800": { "$type": "color", "$value": "#151518" },
      "700": { "$type": "color", "$value": "#232329" }
    },
    "light": {
      "300": { "$type": "color", "$value": "#D8D8DC" },
      "100": { "$type": "color", "$value": "#F2F2F4" },
      "000": { "$type": "color", "$value": "#FFFFFF" }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "8px" },
    "2": { "$type": "dimension", "$value": "16px" },
    "3": { "$type": "dimension", "$value": "24px" },
    "4": { "$type": "dimension", "$value": "32px" },
    "6": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "12": { "$type": "dimension", "$value": "96px" },
    "16": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "16px" },
    "medium": { "$type": "dimension", "$value": "24px" },
    "large": { "$type": "dimension", "$value": "40px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "stroke": {
    "routeDefault": { "$type": "dimension", "$value": "4px" },
    "routeLarge": { "$type": "dimension", "$value": "8px" }
  },
  "logo": {
    "fullBlack": { "$type": "asset", "$value": "../assets/brand/cu-logo-full-black.png" },
    "fullWhite": { "$type": "asset", "$value": "../assets/brand/cu-logo-full-white.png" },
    "markBlack": { "$type": "asset", "$value": "../assets/brand/cu-mark-black.png" },
    "markWhite": { "$type": "asset", "$value": "../assets/brand/cu-mark-white.png" }
  }
}
